---
import { Download, Moon, Search, Sun } from 'lucide-astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '白子诩 · 数字花园', description = '白子诩的个人数字花园：文章、工具、项目、游戏与收藏。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('bai-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
        } catch {
          // Ignore storage restrictions and keep the default light theme.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="白子诩" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="brand-mark"><img src="/assets/logo-mark.png" alt="" width="35" height="35" /></span>
          <span class="brand-copy"><strong>白子诩</strong><small>digital garden</small></span>
        </a>
        <nav class="main-nav" aria-label="主导航">
          <a class:list={{ active: Astro.url.pathname === '/' }} href="/#now">现在</a>
          <a href="/#projects">项目</a>
          <a href="/#games">游戏</a>
          <a class:list={{ active: Astro.url.pathname.startsWith('/library') }} href="/library/">图书馆</a>
          <a href="/#tools">工具</a>
          <a href="/#bookmarks">外链</a>
          <a class:list={{ active: Astro.url.pathname.startsWith('/articles') }} href="/#writing">文章</a>
          <a class:list={{ active: Astro.url.pathname.startsWith('/ideas') }} href="/#ideas">想法</a>
          <a class:list={{ active: Astro.url.pathname.startsWith('/about') }} href="/about/">关于</a>
        </nav>
        <div class="top-actions">
          <button class="icon-button" id="install-button" type="button" aria-label="下载并安装应用" title="下载并安装应用" hidden>
            <Download aria-hidden="true" />
          </button>
          <label class="search-box" for="site-search">
            <Search aria-hidden="true" />
            <input id="site-search" type="search" placeholder="搜索内容" autocomplete="off" />
            <kbd>/</kbd>
          </label>
          <button class="icon-button" id="theme-toggle" type="button" aria-label="切换深色模式" title="切换深色模式">
            <Sun class="theme-sun" aria-hidden="true" />
            <Moon class="theme-moon" aria-hidden="true" />
          </button>
        </div>
      </header>
      <slot />
    </div>
    <div class="no-results" id="no-results" hidden>没有找到匹配的内容。换个关键词试试。</div>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/pwa.ts"></script>
  </body>
</html>
