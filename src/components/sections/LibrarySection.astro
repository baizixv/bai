---
import { BookOpen, ExternalLink, Github, Layers, Type } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';

type Entry = CollectionEntry<'entries'>;
interface Props { bookmarks: Entry[]; }
const { bookmarks } = Astro.props;
const iconMap = { layers: Layers, type: Type, github: Github, 'book-open': BookOpen };
---
<section class="content-section library-section" id="bookmarks">
  <div class="section-wrap">
    <div class="library-layout">
    <div class="section-heading library-heading"><div><p class="eyebrow">05 / EXTERNAL LINKS</p><h2>外链</h2></div><p class="heading-note">收藏不是囤积链接，<br />是给未来的自己留路标。</p></div>
    <div class="library-list searchable-group">
      {bookmarks.map((bookmark, index) => { const Icon = iconMap[bookmark.data.icon ?? 'layers']; return <a class="library-row searchable-item" data-search={`${bookmark.data.title} ${bookmark.data.description} ${bookmark.data.label ?? ''}`} href={bookmark.data.url} target="_blank" rel="noreferrer">
        <span class="library-index">{String(index + 1).padStart(2, '0')}</span><span class={`library-icon ${bookmark.data.color}-icon`}><Icon /></span><span class="library-name"><strong>{bookmark.data.title}</strong><small>{bookmark.data.description}</small></span><span class="library-kind">{bookmark.data.label}</span><span class="external-label">外部链接</span><ExternalLink />
      </a>; })}
    </div>
    </div>
  </div>
</section>
