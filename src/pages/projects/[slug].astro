---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, ExternalLink } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('entries', ({ data }) => data.kind === 'project' || data.kind === 'tool');
  return projects.map((project) => ({ params: { slug: project.id.replace(/\.md$/, '') }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} · Bai / 白`} description={project.data.description}>
  <main class="detail-page section-wrap">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <article class="detail-article">
      <span class="project-type">{project.data.label}</span>
      <h1>{project.data.title}</h1>
      <p class="detail-lede">{project.data.description}</p>
      {project.data.image && <img class="detail-cover" src={project.data.image} alt={`${project.data.title} 项目封面`} width="900" height="600" />}
      <div class="detail-body"><Content /></div>
      {project.data.url?.startsWith('http') && <a class="external-project-link" href={project.data.url} target="_blank" rel="noreferrer"><ExternalLink /><span>访问外部项目</span><ArrowUpRight /></a>}
    </article>
    <a class="next-link" href="/#projects">更多项目 <ArrowUpRight /></a>
  </main>
</Layout>
