---
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';

const projects = (await getCollection('entries', ({ data }) => data.kind === 'project')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="项目 · Bai / 白">
  <main class="archive-page section-wrap">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <div class="archive-heading"><p class="eyebrow">02 / WORKS</p><h1>项目档案</h1><p>把想法做成可以被使用、被打开、被玩一下的东西。</p></div>
    <div class="archive-project-list">
      {projects.map((project) => <a class="archive-project-row" href={`/projects/${project.id.replace(/\.md$/, '')}/`}>
        <div class={`archive-project-visual visual-${project.data.visual}`}>{project.data.image ? <img src={project.data.image} alt="" loading="lazy" /> : <span>{project.data.title}</span>}</div><div><span class="project-type">{project.data.label}</span><h2>{project.data.title}</h2><p>{project.data.description}</p></div><ArrowUpRight />
      </a>)}
    </div>
  </main>
</Layout>
