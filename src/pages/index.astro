---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import WritingSection from '@/components/sections/WritingSection.astro';
import IdeasSection from '@/components/sections/IdeasSection.astro';
import ProjectsSection from '@/components/sections/ProjectsSection.astro';
import ToolsSection from '@/components/sections/ToolsSection.astro';
import GamesSection from '@/components/sections/GamesSection.astro';
import LibrarySection from '@/components/sections/LibrarySection.astro';
import MediaLibrarySection from '@/components/sections/MediaLibrarySection.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import Footer from '@/components/shared/Footer.astro';

const entries = await getCollection('entries');
const articles = entries.filter((entry) => entry.data.kind === 'article').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const ideas = entries.filter((entry) => entry.data.kind === 'idea').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = entries.filter((entry) => entry.data.kind === 'project').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tools = entries.filter((entry) => entry.data.kind === 'tool').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const games = entries.filter((entry) => entry.data.kind === 'game').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const bookmarks = entries.filter((entry) => entry.data.kind === 'bookmark').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const media = entries.filter((entry) => entry.data.kind === 'media').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestEntry = entries
  .filter((entry) => entry.data.kind !== 'idea-version')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
// “最近在做”自动跟随最新条目，不再需要手动标记。
const currentEntry = latestEntry;
const buildDate = new Date();
const formatShortDate = (date: Date) => `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
const stats = { articles: articles.length, projects: projects.length, tools: tools.length, lastUpdated: formatShortDate(buildDate) };
const years = [...new Set(entries.map((entry) => entry.data.date.getFullYear()))].sort((a, b) => a - b);
const period = years.length > 1 ? `${years[0]}—${years[years.length - 1]}` : `${years[0] ?? new Date().getFullYear()}`;
---
<Layout>
  <main id="top">
    <Hero currentEntry={currentEntry} stats={stats} period={period} />
    <ProjectsSection projects={projects} />
    <GamesSection games={games} />
    <MediaLibrarySection media={media} />
    <ToolsSection tools={tools} />
    <LibrarySection bookmarks={bookmarks} />
    <WritingSection articles={articles} />
    <IdeasSection ideas={ideas} />
    <AboutSection />
    <Footer />
  </main>
</Layout>
