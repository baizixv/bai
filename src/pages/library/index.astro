---
import { ArrowLeft, ArrowUpRight, BookOpen, Film, Gamepad2 } from 'lucide-astro';
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

const media = (await getCollection('entries', ({ data }) => data.kind === 'media')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = [
  { type: 'book' as const, label: '书籍', icon: BookOpen },
  { type: 'film' as const, label: '电影', icon: Film },
  { type: 'game' as const, label: '游戏', icon: Gamepad2 }
];
---
<Layout title="图书馆 · Bai / 白" description="Bai 看过的书、电影和游戏。">
  <main class="archive-page library-page section-wrap">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <div class="archive-heading"><p class="eyebrow">06 / LIBRARY</p><h1>图书馆</h1><p>记录看过的书、电影和游戏。这里不追求完整，只留下那些值得以后再想一遍的东西。</p></div>
    <div class="library-catalog">
      {groups.map(({ type, label, icon: Icon }) => { const items = media.filter((item) => item.data.mediaType === type); return <section class="library-catalog-group"><div class="library-catalog-heading"><span class="library-catalog-icon"><Icon /></span><div><span class="eyebrow">{type.toUpperCase()}</span><h2>{label}</h2></div><span class="library-count">{items.length}</span></div>{items.length > 0 ? <div class="library-catalog-list">{items.map((item) => <a class="library-catalog-item" href={item.data.url ?? '#'} target={item.data.url ? '_blank' : undefined} rel={item.data.url ? 'noreferrer' : undefined}><div><h3>{item.data.title}</h3><p>{item.data.creator ?? item.data.description}</p></div><div class="library-item-meta">{item.data.year && <span>{item.data.year}</span>}{item.data.rating !== undefined && <span>{'★'.repeat(Math.round(item.data.rating))}</span>}<ArrowUpRight /></div></a>)}</div> : <p class="library-catalog-empty">还没有记录。新增一个 `kind: media` 的内容条目即可。</p>}</section>; })}
    </div>
  </main>
</Layout>
