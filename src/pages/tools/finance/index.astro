---
import { ArrowLeft, Calculator, TrendingUp } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';
---
<Layout title="财务计算 · 白子诩" description="借贷计算和投资回报测算工具。">
  <main class="tools-page section-wrap finance-page">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <header class="tools-page-header"><div><p class="eyebrow">FINANCE / CALCULATORS</p><h1>财务计算</h1><p>用简单、透明的公式估算借贷月供和投资回报。结果仅作信息参考，不构成金融建议。</p></div><div class="tools-page-mark"><Calculator /></div></header>
    <section class="finance-grid">
      <article class="finance-card">
        <div class="finance-card-head"><div><span class="eyebrow">LOAN</span><h2>借贷计算</h2></div><Calculator /></div>
        <div class="finance-fields"><label>贷款金额（元）<input id="loan-principal" type="number" min="0" value="100000" /></label><label>年利率（%）<input id="loan-rate" type="number" min="0" step="0.01" value="4.2" /></label><label>期限（年）<input id="loan-years" type="number" min="1" max="50" value="5" /></label><label>还款方式<select id="loan-method"><option value="equal-payment">等额本息</option><option value="equal-principal">等额本金</option></select></label></div>
        <button class="benchmark-primary finance-run" id="loan-run" type="button">计算月供 <Calculator /></button><div class="finance-result" id="loan-result" aria-live="polite"><span>预计月供</span><strong>—</strong><small>填写参数后开始计算</small></div>
      </article>
      <article class="finance-card investment-card">
        <div class="finance-card-head"><div><span class="eyebrow">RETURN</span><h2>投资回报测算</h2></div><TrendingUp /></div>
        <div class="finance-fields"><label>初始投入（元）<input id="invest-principal" type="number" min="0" value="100000" /></label><label>每月追加（元）<input id="invest-monthly" type="number" min="0" value="2000" /></label><label>年化收益率（%）<input id="invest-rate" type="number" step="0.1" value="6" /></label><label>投资期限（年）<input id="invest-years" type="number" min="1" max="60" value="10" /></label></div>
        <button class="benchmark-primary finance-run" id="invest-run" type="button">测算回报 <TrendingUp /></button><div class="finance-result" id="invest-result" aria-live="polite"><span>预计终值</span><strong>—</strong><small>按月复利估算</small></div>
      </article>
    </section>
    <p class="finance-disclaimer">计算结果基于输入参数和固定公式，未考虑税费、通胀、手续费、提前还款、市场波动等因素。请勿将测算结果视为收益承诺。</p>
  </main>
</Layout>
<script src="../../../scripts/finance-tools.ts"></script>
