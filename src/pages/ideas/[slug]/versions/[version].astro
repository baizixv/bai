---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, History, Lightbulb } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const versions = await getCollection('entries', ({ data }) => data.kind === 'idea-version');
  return versions.map((version) => ({
    params: { slug: version.data.idea, version: (version.data.version ?? version.id).toLowerCase().replaceAll('.', '-') },
    props: { version },
  }));
}

const { version } = Astro.props;
const ideaSlug = version.data.idea ?? '';
const { Content } = await render(version);
---
<Layout title={`${version.data.title} ${version.data.version ?? ''} · 想法库 · 白子诩`} description={version.data.description}>
  <main class="detail-page idea-detail-page section-wrap">
    <a class="back-link" href={`/ideas/${ideaSlug}/`}><ArrowLeft /> 返回当前版本</a>
    <article class="detail-article">
      <div class="idea-detail-meta"><span class="idea-detail-icon"><Lightbulb /></span><span class="idea-status"><History /> 历史版本</span><span class="idea-version-current">{version.data.version ?? '未命名版本'}</span><span class="mono">{version.data.date.toISOString().slice(0, 10)}</span></div>
      <h1>{version.data.title}</h1><p class="detail-lede">{version.data.description}</p>
      <div class="detail-body"><Content /></div>
    </article>
    <a class="next-link" href={`/ideas/${ideaSlug}/`}><ArrowUpRight /> 查看当前版本</a>
  </main>
</Layout>
