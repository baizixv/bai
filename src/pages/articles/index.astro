---
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';

const articles = (await getCollection('entries', ({ data }) => data.kind === 'article')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---
<Layout title="文章 · Bai / 白">
  <main class="archive-page section-wrap">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <div class="archive-heading"><p class="eyebrow">01 / WORDS</p><h1>文章集</h1><p>记录产品、开发、阅读和那些暂时没有结论的想法。</p></div>
    <div class="archive-list">
      {articles.map((article) => <a class="archive-row" href={`/articles/${article.id.replace(/\.md$/, '')}/`}>
        <span class={`tag tag-${article.data.color ?? 'blue'}`}>{article.data.tag}</span><div><h2>{article.data.title}</h2><p>{article.data.description}</p></div><span class="mono">{formatDate(article.data.date)}</span><ArrowUpRight />
      </a>)}
    </div>
  </main>
</Layout>
