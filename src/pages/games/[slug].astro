---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, ExternalLink, Gamepad2 } from 'lucide-astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const games = await getCollection('entries', ({ data }) => data.kind === 'game');
  return games.map((game) => ({ params: { slug: game.id.replace(/\.md$/, '') }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
---
<Layout title={`${game.data.title} · 白子诩`} description={game.data.description}>
  <main class="detail-page section-wrap game-detail-page">
    <a class="back-link" href="/"><ArrowLeft /> 返回首页</a>
    <article class="detail-article">
      <div class="game-detail-label"><Gamepad2 /> <span>{game.data.label}</span></div>
      <h1>{game.data.title}</h1>
      <p class="detail-lede">{game.data.description}</p>
      {game.data.image && <img class="detail-cover" src={game.data.image} alt={`${game.data.title} 游戏封面`} width="900" height="600" />}
      <div class="detail-actions">
        {game.data.demoUrl && <a class="internal-demo-link" href={game.data.demoUrl}><Gamepad2 /> 在本站体验 <ArrowUpRight /></a>}
        {game.data.url?.startsWith('http') && <a class="external-project-link" href={game.data.url} target="_blank" rel="noreferrer"><ExternalLink /> 阅读知乎原回答 <ArrowUpRight /></a>}
      </div>
      <div class="detail-body"><Content /></div>
    </article>
    <a class="next-link" href="/#games">更多游戏项目 <ArrowUpRight /></a>
  </main>
</Layout>
